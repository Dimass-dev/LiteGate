{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "LiteGate.Gateway": "Debug",
      "Microsoft.AspNetCore": "Warning"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "UseUtcTimestamp": true
      }
    }
  },
  "AllowedHosts": "*",
  "Gateway": {
    "ReservedPaths": [ "/_health", "/_metrics" ],
    "Upstream": {
      "BaseAddress": "http://localhost:5100",
      "TimeoutSeconds": 30
    },
    "Cache": {
      "Enabled": true,
      "DurationSeconds": 30,
      "MaxCacheableBodyBytes": 1048576,
      "MaxStoreBytes": 52428800,
      "VaryByHeaders": []
    },
    "RateLimiting": {
      "Enabled": true,
      "Capacity": 10,
      "RefillTokens": 5,
      "RefillPeriodSeconds": 1,
      "IdleBucketEvictionMinutes": 10,
      "TrustXForwardedFor": false
    },
    "Observability": {
      "LatencySampleWindowSize": 1024
    }
  }
}
